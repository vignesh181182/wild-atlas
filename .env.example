# ── Authentication (Clerk) ────────────────────────────────────────────────
#
# Leave these unset in development and Clerk runs in "keyless" mode: it spins
# up a throwaway instance on first load and shows a link to claim it. Claiming
# is free and gives you the two keys below.
#
# Get them from https://dashboard.clerk.com → your app → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the sign-in and sign-up screens live. These match the routes in
# app/sign-in and app/sign-up — change both together or not at all.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── The reader's profile (Firebase / Firestore) ───────────────────────────
#
# Groups, saved creatures, search history and the daily surprise are kept
# against the signed-in Clerk user id. Everything reaches Firestore from the
# server through the Admin SDK, so the browser never holds these and the
# Firestore rules should stay deny-all — the Admin SDK bypasses them, and
# nothing else is meant to get in.
#
# From the Firebase console for wild-atlas-nd:
#   Project settings -> Service accounts -> Generate new private key
# That downloads a JSON file; these are three fields out of it.
FIREBASE_PROJECT_ID=wild-atlas-nd
FIREBASE_CLIENT_EMAIL=
# Keep the quotes. The key is multi-line; \n escapes survive an env var, and
# src/server/firestore.ts turns them back into real newlines.
FIREBASE_PRIVATE_KEY=""
